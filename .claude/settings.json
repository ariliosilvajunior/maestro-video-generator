{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/detect-video-link.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for a video link…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__copy_file",
      "mcp__Google_Drive__update_file",
      "mcp__Google_Drive__trash_file",
      "mcp__Google_Drive__download_file_content",
      "mcp__Google_Drive__read_file_content",
      "mcp__Google_Drive__create_file",
      "Bash(python3:*)",
      "Bash(curl:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["playwright"]
}
